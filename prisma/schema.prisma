generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (Auth.js / next-auth PrismaAdapter — стандартная схема)
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Пользователь и геймификация
// ---------------------------------------------------------------------------

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?

  xp             Int       @default(0)
  level          Int       @default(1)
  streakCount    Int       @default(0)
  lastActiveDate DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  lessonProgress  UserLessonProgress[]
  achievements    UserAchievement[]
  portfolio       VirtualPortfolio?
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model Course {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  description String
  level       CourseLevel @default(BEGINNER)
  order       Int         @default(0)
  published   Boolean     @default(false)

  modules     Module[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Module {
  id       String   @id @default(cuid())
  courseId String
  title    String
  order    Int      @default(0)

  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@index([courseId])
}

model Lesson {
  id               String   @id @default(cuid())
  moduleId         String
  slug             String
  title            String
  summary          String?
  content          Json
  order            Int      @default(0)
  xpReward         Int      @default(10)
  published        Boolean  @default(false)

  requiredLessonId String?

  module           Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  requiredLesson   Lesson?  @relation("LessonUnlock", fields: [requiredLessonId], references: [id])
  unlocks          Lesson[] @relation("LessonUnlock")

  questions        Question[]
  progress         UserLessonProgress[]

  @@unique([moduleId, slug])
  @@index([moduleId])
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  ORDER
}

model Question {
  id            String       @id @default(cuid())
  lessonId      String
  type          QuestionType @default(SINGLE_CHOICE)
  prompt        String
  options       Json
  correctAnswer Json
  explanation   String?
  order         Int          @default(0)
  xpReward      Int          @default(5)

  lesson        Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

enum LessonStatus {
  LOCKED
  AVAILABLE
  COMPLETED
}

model UserLessonProgress {
  id          String       @id @default(cuid())
  userId      String
  lessonId    String
  status      LessonStatus @default(LOCKED)
  score       Int          @default(0)
  xpEarned    Int          @default(0)
  completedAt DateTime?
  updatedAt   DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

model Achievement {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  description String
  icon        String?

  users       UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime    @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

// ---------------------------------------------------------------------------
// Виртуальный рынок (paper trading)
// ---------------------------------------------------------------------------

model VirtualPortfolio {
  id        String        @id @default(cuid())
  userId    String        @unique
  balance   Float         @default(10000)
  createdAt DateTime      @default(now())

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades    VirtualTrade[]
}

enum TradeSide {
  LONG
  SHORT
}

enum TradeStatus {
  OPEN
  CLOSED
}

model VirtualTrade {
  id          String      @id @default(cuid())
  portfolioId String
  symbol      String
  side        TradeSide
  entryPrice  Float
  exitPrice   Float?
  quantity    Float
  status      TradeStatus @default(OPEN)
  pnl         Float?
  openedAt    DateTime    @default(now())
  closedAt    DateTime?

  portfolio   VirtualPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
}
